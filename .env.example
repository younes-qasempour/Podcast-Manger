# Telegram API Credentials (Get these free from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=tg_podcast_session

# Target Telegram Channel (username e.g. @agrafoss or invite link or chat ID)
TARGET_CHANNEL=@agrafoss

# Download and Organization Settings
OUTPUT_DIR=./podcasts
DOWNLOAD_AUDIO=true
DOWNLOAD_THUMBNAIL=true
EMBED_METADATA_IN_MP3=true

# Proxy Settings (Useful in regions where Telegram is restricted)
# PROXY_ENABLED: true or false
# PROXY_TYPE: socks5 or http
# PROXY_HOST: 127.0.0.1
# PROXY_PORT: 10808 (e.g. V2Ray/v2rayN default is 10808, Clash is 7890)
PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=10808

# GitHub Settings
# Set your GitHub remote repository URL (e.g. https://github.com/username/my-podcasts.git)
GIT_REMOTE_URL=
# GIT_PUSH_AUDIO: false is strongly recommended because GitHub has a 100MB per-file limit!
# When false, audio files stay safely on your local disk, while Markdown notes, metadata,
# thumbnails, and README catalog are committed and pushed to GitHub.
GIT_PUSH_AUDIO=false

